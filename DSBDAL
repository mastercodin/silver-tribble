sns.boxplot(y=df['fare_amount'], orient='v')
plt.show()

sns.boxplot(y=df['passenger_count'], orient='v')
plt.show()

def find_outliers_IQR(data):
    q1 = data.quantile(0.25)
    q3 = data.quantile(0.75)
    IQR = q3 - q1
    lb = q1 - 1.5 * IQR
    ub = q3 + 1.5 * IQR
    outliers = data[(data < lb) | (data > ub)]
    return lb, ub, outliers

lower_bound, upper_bound, outliers = find_outliers_IQR(df['fare_amount'])
print("Number of outliers:", len(outliers))
print("Max outlier value:", outliers.max())
print("Min outlier value:", outliers.min())

df_cleaned = df[(df['fare_amount'] >= lower_bound) & (df['fare_amount'] <= upper_bound)].copy()

print(df_cleaned.shape)

sns.histplot(df_cleaned['fare_amount'])
plt.show()

plt.figure(figsize=(16,5))
