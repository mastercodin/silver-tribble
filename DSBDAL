#df = pd.read_csv('uber.csv')

print(df.head())

print(df.columns)

df = df.drop(columns=['pickup_longitude', 'pickup_latitude', 'dropoff_longitude', 'dropoff_latitude'])

print(df.head())

print(df.describe())

print(df.describe()[['fare_amount', 'passenger_count']])

print(df.shape)

