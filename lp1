/*
FCFS CPU Scheduling Algorithm
*/
#include <stdio.h>
#include <stdlib.h>
#define MAX_PROCESSES 10

struct Process {
    int id;
    int burst_time;
    int waiting_time;
    int turnaround_time;
};

struct Process processes[MAX_PROCESSES];
int num_processes = 0;

void initialize_processes() {
    printf("=== First-Come, First-Served (FCFS) Scheduling ===\n\n");
    printf("Enter number of processes (max %d): ", MAX_PROCESSES);
    scanf("%d", &num_processes);
    
    if (num_processes <= 0 || num_processes > MAX_PROCESSES) {
        printf("Invalid number of processes. Exiting.\n");
        exit(1);
    }
    
    for (int i = 0; i < num_processes; i++) {
        processes[i].id = i + 1;
        printf("Enter burst time for Process P%d: ", processes[i].id);
        scanf("%d", &processes[i].burst_time);
    }
}

void calculate_fcfs() {
    // First process has zero waiting time
    processes[0].waiting_time = 0;
    
    // Calculate waiting time for subsequent processes
    for (int i = 1; i < num_processes; i++) {
        processes[i].waiting_time = processes[i-1].waiting_time + processes[i-1].burst_time;
    }
    
    // Calculate turnaround time for all processes
    for (int i = 0; i < num_processes; i++) {
        processes[i].turnaround_time = processes[i].waiting_time + processes[i].burst_time;
    }
}

void display_results() {
    printf("\n--- FCFS Scheduling Results ---\n");
    printf("Process\tBurst Time\tWaiting Time\tTurnaround Time\n");
    printf("----------------------------------------------------\n");
    
    float total_wt = 0, total_tat = 0;
    
    for (int i = 0; i < num_processes; i++) {
        printf("P%d\t%d\t\t%d\t\t%d\n",
               processes[i].id,
               processes[i].burst_time,
               processes[i].waiting_time,
               processes[i].turnaround_time);
        
        total_wt += processes[i].waiting_time;
        total_tat += processes[i].turnaround_time;
    }
    
    printf("----------------------------------------------------\n");
    printf("Average Waiting Time: %.2f\n", total_wt / num_processes);
    printf("Average Turnaround Time: %.2f\n", total_tat / num_processes);
}

int main() {
    initialize_processes();
    calculate_fcfs();
    display_results();
    return 0;
}


/*
SJF CPU Scheduling Algorithm
*/
#include <stdio.h>
#include <stdlib.h>
#define MAX_PROCESSES 10

struct Process {
    int id;
    int burst_time;
    int arrival_time;
    int remaining_time;
    int waiting_time;
    int turnaround_time;
    int completed;
};

struct Process processes[MAX_PROCESSES];
int num_processes = 0;

void initialize_processes() {
    printf("=== Shortest Job First (Preemptive) Scheduling ===\n\n");
    printf("Enter number of processes (max %d): ", MAX_PROCESSES);
    scanf("%d", &num_processes);
    
    for (int i = 0; i < num_processes; i++) {
        processes[i].id = i + 1;
        printf("Enter arrival time for Process P%d: ", processes[i].id);
        scanf("%d", &processes[i].arrival_time);
        printf("Enter burst time for Process P%d: ", processes[i].id);
        scanf("%d", &processes[i].burst_time);
        processes[i].remaining_time = processes[i].burst_time;
        processes[i].completed = 0;
        processes[i].waiting_time = 0;
        processes[i].turnaround_time = 0;
    }
}

void calculate_sjf() {
    int current_time = 0;
    int completed = 0;
    int shortest = -1;
    int min_burst = 9999;
    int check = 0;
    
    while (completed != num_processes) {
        for (int i = 0; i < num_processes; i++) {
            if (processes[i].arrival_time <= current_time && processes[i].remaining_time < min_burst && processes[i].remaining_time > 0) {
                min_burst = processes[i].remaining_time;
                shortest = i;
                check = 1;
            }
        }
        
        if (check == 0) {
            current_time++;
            continue;
        }
        
        processes[shortest].remaining_time--;
        min_burst = processes[shortest].remaining_time;
        
        if (min_burst == 0) {
            min_burst = 9999;
        }
        
        if (processes[shortest].remaining_time == 0) {
            completed++;
            check = 0;
            processes[shortest].turnaround_time = current_time + 1 - processes[shortest].arrival_time;
            processes[shortest].waiting_time = processes[shortest].turnaround_time - processes[shortest].burst_time;
            if (processes[shortest].waiting_time < 0) processes[shortest].waiting_time = 0;
        }
        current_time++;
    }
}

void display_results() {
    printf("\n--- SJF CPU Sheduling Algorithm ---\n");
    printf("Process\tBurst Time\tWaiting Time\tTurnaround Time\n");
    printf("----------------------------------------------------\n");
    
    float total_wt = 0, total_tat = 0;
    
    for (int i = 0; i < num_processes; i++) {
        printf("P%d\t%d\t\t%d\t\t%d\n",
               processes[i].id,
               processes[i].burst_time,
               processes[i].waiting_time,
               processes[i].turnaround_time);
        
        total_wt += processes[i].waiting_time;
        total_tat += processes[i].turnaround_time;
    }
    
    printf("----------------------------------------------------\n");
    printf("Average Waiting Time: %.2f\n", total_wt / num_processes);
    printf("Average Turnaround Time: %.2f\n", total_tat / num_processes);
}

int main() {
    initialize_processes();
    calculate_sjf();
    display_results();
    return 0;
}

/*
Priority CPU Scheduling Algorithm
*/
#include <stdio.h>
#include <stdlib.h>
#define MAX_PROCESSES 10

struct Process {
    int id;
    int burst_time;
    int priority;
    int waiting_time;
    int turnaround_time;
    int completed;
};

struct Process processes[MAX_PROCESSES];
int num_processes = 0;

void initialize_processes() {
    printf("=== Priority (Non-Preemptive) Scheduling ===\n\n");
    printf("Enter number of processes (max %d): ", MAX_PROCESSES);
    scanf("%d", &num_processes);
    
    for (int i = 0; i < num_processes; i++) {
        processes[i].id = i + 1;
        printf("Enter burst time for Process P%d: ", processes[i].id);
        scanf("%d", &processes[i].burst_time);
        printf("Enter priority for Process P%d: ", processes[i].id);
        scanf("%d", &processes[i].priority);
        processes[i].completed = 0;
        processes[i].waiting_time = 0;
        processes[i].turnaround_time = 0;
    }
}

void calculate_priority() {
    int current_time = 0;
    int completed = 0;
    
    while (completed != num_processes) {
        int highest_priority = -1;
        int max_priority = 9999;
        
        for (int i = 0; i < num_processes; i++) {
            if (processes[i].completed == 0 && processes[i].priority < max_priority) {
                max_priority = processes[i].priority;
                highest_priority = i;
            }
        }
        
        if (highest_priority == -1) {
            current_time++;
            continue;
        }
        
        processes[highest_priority].waiting_time = current_time;
        current_time += processes[highest_priority].burst_time;
        processes[highest_priority].turnaround_time = current_time;
        processes[highest_priority].completed = 1;
        completed++;
    }
}

void display_results() {
    printf("\n--- Priority Scheduling Results ---\n");
    printf("Process\tBurst Time\tPriority\tWaiting Time\tTurnaround Time\n");
    printf("----------------------------------------------------------------\n");
    
    float total_wt = 0, total_tat = 0;
    
    for (int i = 0; i < num_processes; i++) {
        printf("P%d\t%d\t\t%d\t\t%d\t\t%d\n",
               processes[i].id,
               processes[i].burst_time,
               processes[i].priority,
               processes[i].waiting_time,
               processes[i].turnaround_time);
        
        total_wt += processes[i].waiting_time;
        total_tat += processes[i].turnaround_time;
    }
    
    printf("----------------------------------------------------------------\n");
    printf("Average Waiting Time: %.2f\n", total_wt / num_processes);
    printf("Average Turnaround Time: %.2f\n", total_tat / num_processes);
}

int main() {
    initialize_processes();
    calculate_priority();
    display_results();
    return 0;
}

/*
Round Robin CPU Scheduling Algorithm
*/
#include <stdio.h>
#include <stdlib.h>
#define MAX_PROCESSES 10

struct Process {
    int id;
    int burst_time;
    int arrival_time;
    int remaining_time;
    int waiting_time;
    int turnaround_time;
    int completed;
};

struct Process processes[MAX_PROCESSES];
int num_processes = 0;
int time_quantum = 0;

void initialize_processes() {
    printf("=== Round Robin (Preemptive) Scheduling ===\n\n");
    printf("Enter number of processes (max %d): ", MAX_PROCESSES);
    scanf("%d", &num_processes);
    
    printf("Enter time quantum: ");
    scanf("%d", &time_quantum);
    
    for (int i = 0; i < num_processes; i++) {
        processes[i].id = i + 1;
        printf("Enter arrival time for Process P%d: ", processes[i].id);
        scanf("%d", &processes[i].arrival_time);
        printf("Enter burst time for Process P%d: ", processes[i].id);
        scanf("%d", &processes[i].burst_time);
        processes[i].remaining_time = processes[i].burst_time;
        processes[i].completed = 0;
        processes[i].waiting_time = 0;
        processes[i].turnaround_time = 0;
    }
}

void calculate_rr() {
    int current_time = 0;
    int completed = 0;
    int queue[MAX_PROCESSES];
    int front = 0, rear = 0;
    int in_queue[MAX_PROCESSES] = {0};
    
    for (int i = 0; i < num_processes; i++) {
        if (processes[i].arrival_time <= current_time && !in_queue[i]) {
            queue[rear++] = i;
            in_queue[i] = 1;
        }
    }
    
    while (completed != num_processes) {
        if (front == rear) {
            current_time++;
            for (int i = 0; i < num_processes; i++) {
                if (processes[i].arrival_time <= current_time && !in_queue[i] && processes[i].remaining_time > 0) {
                    queue[rear++] = i;
                    in_queue[i] = 1;
                }
            }
            continue;
        }
        
        int current = queue[front++];
        in_queue[current] = 0;
        
        int exec_time = (processes[current].remaining_time > time_quantum) ? time_quantum : processes[current].remaining_time;
        processes[current].remaining_time -= exec_time;
        current_time += exec_time;
        
        for (int i = 0; i < num_processes; i++) {
            if (processes[i].arrival_time <= current_time && !in_queue[i] && processes[i].remaining_time > 0 && i != current) {
                queue[rear++] = i;
                in_queue[i] = 1;
            }
        }
        
        if (processes[current].remaining_time > 0) {
            queue[rear++] = current;
            in_queue[current] = 1;
        } else {
            completed++;
            processes[current].turnaround_time = current_time - processes[current].arrival_time;
            processes[current].waiting_time = processes[current].turnaround_time - processes[current].burst_time;
        }
    }
}

void display_results() {
    printf("\n--- Round Robin Scheduling Results ---\n");
    printf("Process\tBurst Time\tWaiting Time\tTurnaround Time\n");
    printf("----------------------------------------------------\n");
    
    float total_wt = 0, total_tat = 0;
    
    for (int i = 0; i < num_processes; i++) {
        printf("P%d\t%d\t\t%d\t\t%d\n",
               processes[i].id,
               processes[i].burst_time,
               processes[i].waiting_time,
               processes[i].turnaround_time);
        
        total_wt += processes[i].waiting_time;
        total_tat += processes[i].turnaround_time;
    }
    
    printf("----------------------------------------------------\n");
    printf("Average Waiting Time: %.2f\n", total_wt / num_processes);
    printf("Average Turnaround Time: %.2f\n", total_tat / num_processes);
}

int main() {
    initialize_processes();
    calculate_rr();
    display_results();
    return 0;
}

/*
First Fit Memory Allocation Algorithm
*/
#include <stdio.h>
#define MAX_BLOCKS 10
#define MAX_PROCESSES 10

int blocks[MAX_BLOCKS];
int processes[MAX_PROCESSES];
int block_allocation[MAX_PROCESSES];
int num_blocks, num_processes;

void initialize() {
    printf("=== First Fit Memory Allocation ===\n\n");
    printf("Enter number of memory blocks: ");
    scanf("%d", &num_blocks);
    printf("Enter size of each memory block:\n");
    for(int i = 0; i < num_blocks; i++) {
        printf("Block %d: ", i+1);
        scanf("%d", &blocks[i]);
    }
    printf("Enter number of processes: ");
    scanf("%d", &num_processes);
    printf("Enter size of each process:\n");
    for(int i = 0; i < num_processes; i++) {
        printf("Process %d: ", i+1);
        scanf("%d", &processes[i]);
        block_allocation[i] = -1;
    }
}

void first_fit() {
    for(int i = 0; i < num_processes; i++) {
        for(int j = 0; j < num_blocks; j++) {
            if(blocks[j] >= processes[i]) {
                block_allocation[i] = j + 1;
                blocks[j] -= processes[i];
                break;
            }
        }
    }
}

void display_results() {
    printf("\nProcess No.\tProcess Size\tBlock no.\n");
    for(int i = 0; i < num_processes; i++) {
        printf("%d\t\t%d\t\t", i+1, processes[i]);
        if(block_allocation[i] != -1)
            printf("%d\n", block_allocation[i]);
        else
            printf("Not Allocated\n");
    }
}

int main() {
    initialize();
    first_fit();
    display_results();
    return 0;
}

