static void enqueue_new_arrivals(int current_time, struct Process *procs, int num_processes,int *queue, int *rear, int *is_in_system, int *processes_arrived);
void calculate_rr(struct Process *procs, int num_processes, int time_quantum, struct GanttSegment *gantt, int *gantt_idx_ptr);
