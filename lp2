public class SelectionSortUtil {
    public static List<Integer> selectionSort(List<Integer> arr) {
        if (arr == null) return arr;
        Integer n = arr.size();
        for (Integer i = 0; i < n - 1; i++) {
            Integer minIdx = i;
            for (Integer j = i + 1; j < n; j++) {
                if (arr[j] < arr[minIdx]) {
                    minIdx = j;
                }
            }
            if (minIdx != i) {
                Integer temp = arr[i];
                arr[i] = arr[minIdx];
                arr[minIdx] = temp;
            }
        }
        return arr;
    }

    @IsTest
    private static void testSelectionSort() {
        List<Integer> input = new List<Integer>{64, 25, 12, 22, 11};
        List<Integer> sorted = selectionSort(new List<Integer>(input));
        System.assertEquals(new List<Integer>{11, 12, 22, 25, 64}, sorted);
    }
}

