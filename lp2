# Problem 7: Kruskal's Minimum Spanning Tree

```python
class UnionFind:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n

    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]

    def union(self, x, y):
        rx, ry = self.find(x), self.find(y)
        if rx == ry:
            return False
        if self.rank[rx] < self.rank[ry]:
            self.parent[rx] = ry
        elif self.rank[rx] > self.rank[ry]:
            self.parent[ry] = rx
        else:
            self.parent[ry] = rx
            self.rank[rx] += 1
        return True

def kruskals_mst(num_vertices, edges):
    edges.sort(key=lambda x: x[2])
    uf = UnionFind(num_vertices)
    mst = []
    total_cost = 0

    for u, v, weight in edges:
        if uf.union(u, v):
            mst.append((u, v, weight))
            total_cost += weight
            if len(mst) == num_vertices - 1:
                break

    return mst, total_cost

def main():
    num_vertices = 4
    edges = [
        (0, 1, 10),
        (0, 2, 6),
        (0, 3, 5),
        (1, 3, 15),
        (2, 3, 4)
    ]
    mst, cost = kruskals_mst(num_vertices, edges)
    print("Kruskal's MST Edges:")
    for u, v, w in mst:
        print(f"  {u} -- {v}  weight: {w}")
    print(f"Total Cost: {cost}")

if __name__ == "__main__":
    main()
