    1: [0, 3, 4],
    2: [0, 5, 6],
    3: [1],
    4: [1],
    5: [2],
    6: [2]
}

print("BFS Traversal starting from vertex 0:")
print(" -> ".join(map(str, bfs(graph, 0))))



# Problem 3: Implement A star Algorithm for any game search problem.


import heapq

class PuzzleState:
    def __init__(self, board, goal, moves=0, parent=None):
        self.board = board
        self.goal = goal
        self.moves = moves
        self.parent = parent
        self.blank = board.index(0)
        self.priority = self.moves + self.heuristic()

    def heuristic(self):
        return sum(
            abs(i//3 - self.goal.index(tile)//3) + abs(i%3 - self.goal.index(tile)%3)
            for i, tile in enumerate(self.board) if tile != 0
        )

    def neighbors(self):
        n = []
        r, c = divmod(self.blank, 3)
        for dr, dc in ((-1,0),(1,0),(0,-1),(0,1)):
            nr, nc = r+dr, c+dc
            if 0 <= nr < 3 and 0 <= nc < 3:
                nb = self.board[:]
                j = nr*3 + nc
                nb[self.blank], nb[j] = nb[j], nb[self.blank]
                n.append(PuzzleState(nb, self.goal, self.moves+1, self))
        return n

    def is_goal(self): return self.board == self.goal
    def __lt__(self, other): return self.priority < other.priority
    def __hash__(self): return hash(tuple(self.board))

def a_star(start, goal):
    start_state = PuzzleState(start, goal)
    open_heap = [start_state]
    closed = set()
    while open_heap:
        cur = heapq.heappop(open_heap)
        if cur.is_goal():
            path = []
            while cur:
                path.append(cur.board)
                cur = cur.parent
            return path[::-1]
        closed.add(tuple(cur.board))
        for nb in cur.neighbors():
            if tuple(nb.board) in closed: 
                continue
            heapq.heappush(open_heap, nb)
    return None

