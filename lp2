# Problem 3: A* Algorithm (8-Puzzle Game)

```python
import heapq

class PuzzleState:
    def __init__(self, board, goal, moves=0, parent=None):
        self.board = board
        self.goal = goal
        self.moves = moves
        self.parent = parent
        self.blank = board.index(0)
        self.priority = self.moves + self.heuristic()

    def heuristic(self):
        distance = 0
        for i, tile in enumerate(self.board):
            if tile != 0:
                goal_index = self.goal.index(tile)
                distance += abs(i // 3 - goal_index // 3) + abs(i % 3 - goal_index % 3)
        return distance

    def get_neighbors(self):
        neighbors = []
        row, col = divmod(self.blank, 3)
        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]
        for dr, dc in directions:
            new_row, new_col = row + dr, col + dc
            if 0 <= new_row < 3 and 0 <= new_col < 3:
                new_board = self.board[:]
                new_blank = new_row * 3 + new_col
                new_board[self.blank], new_board[new_blank] = new_board[new_blank], new_board[self.blank]
                neighbors.append(PuzzleState(new_board, self.goal, self.moves + 1, self))
        return neighbors

    def is_goal(self):
        return self.board == self.goal

    def __lt__(self, other):
        return self.priority < other.priority

    def __eq__(self, other):
        return self.board == other.board

    def __hash__(self):
        return hash(tuple(self.board))

def a_star(start, goal):
    start_state = PuzzleState(start, goal)
    open_set = []
    heapq.heappush(open_set, start_state)
    closed_set = set()

    while open_set:
        current = heapq.heappop(open_set)
        if current.is_goal():
            path = []
            while current:
                path.append(current.board)
                current = current.parent
            return path[::-1]
        closed_set.add(tuple(current.board))
        for neighbor in current.get_neighbors():
            if tuple(neighbor.board) not in closed_set:
                heapq.heappush(open_set, neighbor)
    return None

def print_board(board):
    for i in range(0, 9, 3):
        print(board[i:i+3])
    print()

def main():
    start = [1, 2, 5, 3, 4, 0, 6, 7, 8]
    goal  = [1, 2, 5, 3, 4, 8, 6, 7, 0]
    print("Start State:")
    print_board(start)
    print("Goal State:")
    print_board(goal)
    path = a_star(start, goal)
    if path:
        print(f"Solution found in {len(path)-1} moves:")
        for step in path:
            print_board(step)
    else:
        print("No solution found.")

if __name__ == "__main__":
    main()
```

