        List<Integer> input = new List<Integer>{64, 25, 12, 22, 11};
        List<Integer> sorted = selectionSort(new List<Integer>(input));
        System.assertEquals(new List<Integer>{11, 12, 22, 25, 64}, sorted);
    }
