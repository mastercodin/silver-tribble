class Solution:
    def prims(self, vertices, edges, src):
        adj = {i: [] for i in range(vertices)}
        
        for u, v, w in edges:
            adj[u].append((v, w))
            adj[v].append((u, w))
            
        st = set()
        visited = [False] * vertices
        
        mst_weight = 0
        parent = [-1] * vertices  
        
        st.add((0, src, -1)) 
        
        mst_edges = []
        
        while st:
            weight, node, par = min(st)
            st.remove((weight, node, par))
            
            if visited[node]:
                continue
            
            visited[node] = True
            mst_weight += weight
            parent[node] = par
            
            if par != -1:
                mst_edges.append((par, node, weight))
            
            for neighbor, edgewt in adj[node]:
                if not visited[neighbor]:
                    st.add((edgewt, neighbor, node))
                    
        return mst_weight, mst_edges


