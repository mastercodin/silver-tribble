import sys

class Solution:
    def dijistras(self, vertices, edges, src):
        adj = {i: [] for i in range(vertices)}
        
        for u, v, w in edges:
            adj[u].append((v, w))
            adj[v].append((u, w))
        
        dist = [sys.maxsize] * vertices
        parent = [-1] * vertices
        
        dist[src] = 0
        
        st = set()
        st.add((0, src))
        
        while st:
            nodeDist, topNode = min(st)
            st.remove((nodeDist, topNode))
            
            for neighbor, weight in adj[topNode]:
                if nodeDist + weight < dist[neighbor]:
                    
                    if (dist[neighbor], neighbor) in st:
                        st.remove((dist[neighbor], neighbor))
                    
                    dist[neighbor] = nodeDist + weight
                    parent[neighbor] = topNode
                    st.add((dist[neighbor], neighbor))
        
        return dist, parent


def get_path(parent, node):
    path = []
    while node != -1:
        path.append(node)
        node = parent[node]
    return path[::-1]


